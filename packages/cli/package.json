{
	"name": "@crescenthq/moon",
	"description": "CLI Tool for sharing your agent sesh with Moon!",
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"moon": "./dist/moon"
	},
	"scripts": {
		"build": "bun build src/cli.ts --target=node --outdir=dist",
		"build:compile": "bun build --compile --minify --sourcemap src/cli.ts --outfile=dist/skills-installer",
		"test": "bun test",
		"dev": "bun run src/cli.ts",
		"publish:npm": "bun run build && npm publish"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"citty": "^0.2.0",
		"open": "^10.1.0",
		"picocolors": "^1.1.1"
	}
}
